<?xml version="1.0" encoding="UTF-8"?>
<!--
    SpotBugs / find-sec-bugs exclusions (issue #110). Every entry needs a reason; prefer fixing the code or a
    narrow @SuppressFBWarnings(justification = ...) over a broad pattern here.
-->
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!--
        EI_EXPOSE_REP / EI_EXPOSE_REP2: records, Spring @ConfigurationProperties and constructor-injected
        collaborators hand out or keep references by design; flagged on almost every class.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- CT_CONSTRUCTOR_THROW: finalizer attacks do not apply; constructors validate their arguments and throw on purpose. -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- Tests are not shipped. -->
    <Match>
        <Class name="~.*Test(\$.*)?"/>
    </Match>
</FindBugsFilter>
