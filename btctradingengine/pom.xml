<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Reactor root (issue #133). Dependencies point inward:
          engine-core  <-  engine-data  <-  engine-trading  <-  engine-app
          engine-core  <-  engine-backtest                  <-  engine-app
        engine-core has no Spring, JDBC or HTTP client on its compile classpath; only engine-app is a
        Spring Boot application and builds the executable jar.
        Planned modules (not created yet): engine-research (#112), engine-copytrading (#120), engine-scanner (#127).
    -->
    <groupId>dev.romeo</groupId>
    <artifactId>btc-trading-engine-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <modules>
        <module>engine-core</module>
        <module>engine-data</module>
        <module>engine-trading</module>
        <module>engine-backtest</module>
        <module>engine-app</module>
    </modules>

    <properties>
        <revision>1.0.1-SNAPSHOT</revision>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring-boot.version>3.5.5</spring-boot.version>
        <!-- Not in the Spring Boot BOM: one version for every resilience4j-* module (issue #100) -->
        <resilience4j.version>2.4.0</resilience4j.version>

        <!-- Quality tooling (issue #110). Plugin versions only: dependency versions come from the Boot BOM. -->
        <spotless.version>2.46.1</spotless.version>
        <!-- Spotless only checks files changed since this ref; CI passes the PR base (-Dspotless.ratchetFrom=origin/<base>) -->
        <spotless.ratchetFrom>origin/main</spotless.ratchetFrom>
        <checkstyle-plugin.version>3.6.0</checkstyle-plugin.version>
        <checkstyle.version>14.1.0</checkstyle.version>
        <jacoco.version>0.8.15</jacoco.version>
        <spotbugs-plugin.version>4.10.4.1</spotbugs-plugin.version>
        <findsecbugs.version>1.14.0</findsecbugs.version>
        <spotbugs.failOnError>false</spotbugs.failOnError>
        <errorprone.version>2.50.0</errorprone.version>
        <nullaway.version>0.14.1</nullaway.version>
        <dependency-check.version>13.0.0</dependency-check.version>

        <!-- Not in the Spring Boot BOM: Binance HTTP stubs of the integration tests (issue #103) -->
        <wiremock.version>3.13.2</wiremock.version>
        <!-- Overrides the Boot BOM's 1.21.3, whose docker-java API version Docker Engine 29 rejects with HTTP 400 (issue #103) -->
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Before the Boot BOM, so its Testcontainers version wins -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock-standalone</artifactId>
                <version>${wiremock.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.romeo</groupId>
                <artifactId>engine-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>dev.romeo</groupId>
                <artifactId>engine-data</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>dev.romeo</groupId>
                <artifactId>engine-trading</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>dev.romeo</groupId>
                <artifactId>engine-backtest</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <!-- Spring binds @Bean and constructor parameters by name, as spring-boot-starter-parent set up -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.3</version>
                </plugin>
                <!-- *IT classes (Testcontainers, WireMock) run in integration-test/verify, not in test (issue #103) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.5.3</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>${spotbugs-plugin.version}</version>
                    <configuration>
                        <effort>Max</effort>
                        <threshold>Medium</threshold>
                        <xmlOutput>true</xmlOutput>
                        <failOnError>${spotbugs.failOnError}</failOnError>
                        <excludeFilterFile>${maven.multiModuleProjectDirectory}/config/spotbugs/exclude.xml</excludeFilterFile>
                        <plugins>
                            <plugin>
                                <groupId>com.h3xstream.findsecbugs</groupId>
                                <artifactId>findsecbugs-plugin</artifactId>
                                <version>${findsecbugs.version}</version>
                            </plugin>
                        </plugins>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>${dependency-check.version}</version>
                    <configuration>
                        <!-- Report only (issue #110): 11 is above every CVSS score, so no finding fails the build -->
                        <failBuildOnCVSS>11</failBuildOnCVSS>
                        <formats>
                            <format>HTML</format>
                            <format>SARIF</format>
                        </formats>
                        <!-- Optional; without a key the NVD download is much slower. CI passes the NVD_API_KEY secret. -->
                        <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
                        <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Replaces ${revision} in the installed poms, so the modules resolve each other outside the reactor -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.7.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                Formatting (issues #96, #110). Not bound to a phase: CI runs `spotless:check`. ratchetFrom limits it
                to files changed since ${spotless.ratchetFrom}, so the existing code is not reformatted in one go;
                a file is formatted as a whole the first time it is touched. `mvnw spotless:apply` fixes it.
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <ratchetFrom>${spotless.ratchetFrom}</ratchetFrom>
                    <java>
                        <googleJavaFormat>
                            <version>1.30.0</version>
                            <!-- AOSP = 4-space indentation, the style the code base already uses -->
                            <style>AOSP</style>
                        </googleJavaFormat>
                    </java>
                </configuration>
            </plugin>

            <!-- Lenient Checkstyle ruleset (issue #110): fails only on error-severity rules, which the code already passes -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstyle-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <consoleOutput>false</consoleOutput>
                    <violationSeverity>error</violationSeverity>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Coverage (issue #110): per-module reports; engine-app aggregates them, core/trading enforce minimums -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Error Prone + NullAway (issue #110): `mvnw -Pstrict verify`. Error Prone's ERROR-level checks fail the
            compilation; NullAway only warns until the code is annotated. javac is forked because Error Prone
            needs the jdk.compiler internals exported.
        -->
        <profile>
            <id>strict</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <fork>true</fork>
                            <compilerArgs combine.children="append">
                                <arg>-Xmaxwarns</arg>
                                <arg>10000</arg>
                                <arg>-XDcompilePolicy=simple</arg>
                                <arg>--should-stop=ifError=FLOW</arg>
                                <arg>-Xplugin:ErrorProne -XepDisableWarningsInGeneratedCode -Xep:NullAway:WARN -XepOpt:NullAway:AnnotatedPackages=dev.romeo.btctradingengine</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                                <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                                <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                            </compilerArgs>
                            <annotationProcessorPaths combine.children="append">
                                <path>
                                    <groupId>com.google.errorprone</groupId>
                                    <artifactId>error_prone_core</artifactId>
                                    <version>${errorprone.version}</version>
                                </path>
                                <path>
                                    <groupId>com.uber.nullaway</groupId>
                                    <artifactId>nullaway</artifactId>
                                    <version>${nullaway.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- SpotBugs + find-sec-bugs (issue #110): `mvnw -Pspotbugs verify -DskipTests`. Reports only, unless -Dspotbugs.failOnError=true. -->
        <profile>
            <id>spotbugs</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>spotbugs</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- JMH benchmarks (issue #110), outside the default build: `mvnw -Pbenchmarks -pl engine-benchmarks -am package` -->
        <profile>
            <id>benchmarks</id>
            <modules>
                <module>engine-benchmarks</module>
            </modules>
        </profile>
    </profiles>
</project>
