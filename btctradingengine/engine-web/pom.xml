<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.romeo</groupId>
        <artifactId>btc-trading-engine-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <!--
        The Angular dashboard (issue #134). `ng build` writes straight into target/classes/static, so this jar
        carries the app under classpath:/static and engine-app serves it from its single executable jar.

        The Node build only runs with -P frontend (CI, Docker and releases), so a backend-only build stays fast;
        without the profile this jar is empty and the engine runs without the dashboard UI.
    -->
    <artifactId>engine-web</artifactId>
    <name>engine-web</name>
    <description>Angular dashboard, packaged as static resources for engine-app.</description>

    <properties>
        <frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
        <!-- Angular 22 needs Node ^22.22.3 or ^24.15 -->
        <node.version>v24.16.0</node.version>
    </properties>

    <profiles>
        <profile>
            <id>frontend</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <version>${frontend-maven-plugin.version}</version>
                        <configuration>
                            <nodeVersion>${node.version}</nodeVersion>
                            <installDirectory>target</installDirectory>
                        </configuration>
                        <executions>
                            <execution>
                                <id>install-node-and-npm</id>
                                <goals>
                                    <goal>install-node-and-npm</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>npm-ci</id>
                                <goals>
                                    <goal>npm</goal>
                                </goals>
                                <configuration>
                                    <arguments>ci --no-audit --no-fund</arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>npm-build</id>
                                <phase>compile</phase>
                                <goals>
                                    <goal>npm</goal>
                                </goals>
                                <configuration>
                                    <arguments>run build</arguments>
                                </configuration>
                            </execution>
                            <!-- Skipped with -DskipTests, like the Java tests -->
                            <execution>
                                <id>npm-test</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>npm</goal>
                                </goals>
                                <configuration>
                                    <arguments>run test:ci</arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
