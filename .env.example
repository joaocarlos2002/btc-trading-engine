# Copy to .env and fill in. .env is git-ignored: no secret belongs in a versioned file.
#
# docker compose reads .env by itself. The application reads it too: SecretsEnvironmentPostProcessor loads the
# .env in the directory the JVM was started from (or up to two levels above it), so `docker compose up -d postgres` and `mvn spring-boot:run`
# both work with nothing but this file. A real environment variable always wins over .env, and .env
# always wins over application.properties.

# Password for the Postgres user btc_engine. Used both to create the container's database and to
# connect to it, so the two can never drift apart.
BTC_ENGINE_DB_PASSWORD=

# Binance API credentials. Only needed with trading.real.enabled=true.
# Testnet keys: https://testnet.binance.vision
BTC_ENGINE_BINANCE_API_KEY=
BTC_ENGINE_BINANCE_API_SECRET=

# OCO protection (target/stop resting on Binance) for real positions. Optional; defaults to true
# (trading.oco.enabled). Set to false to go back to exits driven only by the bot's price ticks.
BTC_ENGINE_TRADING_OCO_ENABLED=

# Position sizing of real entries: fixed (default, 50% of the USDT balance), atr or kelly
# (trading.sizing.strategy; tune the rest in application.properties). Optional.
BTC_ENGINE_TRADING_SIZING_STRATEGY=

# Discord webhook for critical alerts. Optional; blank disables the alerts.
BTC_ENGINE_DISCORD_WEBHOOK_URL=

# Grafana admin password for `docker compose --profile observability up -d` (issue #104). Optional; Grafana
# is bound to 127.0.0.1:3000 and falls back to admin/admin, which it asks you to change on first login.
GRAFANA_ADMIN_PASSWORD=
